{
  "name": "megaview-ui",
  "version": "0.0.10",
  "description": "深维会话纪要可视化组件库 - 基于 Web Components",
  "type": "module",
  "main": "./dist/megaview-ui.umd.js",
  "module": "./dist/megaview-ui.es.js",
  "browser": "./dist/megaview-ui.iife.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/megaview-ui.es.js",
      "require": "./dist/megaview-ui.umd.js",
      "browser": "./dist/megaview-ui.iife.js"
    }
  },
  "files": [
    "dist",
    "dist/types",
    "README.md",
    "CHANGELOG.md",
    "DEPLOYMENT.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "web-test-runner --coverage --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --coverage --watch --config web-test-runner.config.mjs",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release",
    "link": "npm link && echo 组件库已链接，现在运行 npm run build 构建，然后启动examples即可实时验证",
    "dev:examples": "npm run build && echo '✅ 组件库已构建完成！现在可以运行: npm run example:vue3 或 npm run example:react 或 npm run example:vue2'",
    "example:vue3": "cd examples/vue3 && npm run dev",
    "example:react": "cd examples/react && npm run dev",
    "example:vue2": "cd examples/vue2 && npm run dev",
    "examples:help": "echo ==================================== && echo      MegaviewUI 开发指南 && echo ==================================== && echo. && echo 🔧 实时验证组件修改 (推荐): && echo   步骤: && echo   1. 修改组件库代码 (src目录下) && echo   2. npm run build && echo   3. 如果examples已启动，会自动看到变化 && echo. && echo 🔄 自动监听模式 (可选): && echo   npm run dev:watch  - 自动重新构建 (新终端) && echo   npm run example:vue3 - 启动示例验证 (另一个终端) && echo. && echo 💡 技术说明: && echo   examples使用 file:../.. 依赖主项目的dist目录 && echo   修改源码后需要重新build才能生效 && echo. && echo 📍 默认端口: && echo   Vue3:  http://localhost:5173 && echo   React: http://localhost:5174 && echo   Vue2:  http://localhost:5175"
  },
  "keywords": [
    "web-components",
    "conversation",
    "summary",
    "visualization",
    "megaview",
    "cdn"
  ],
  "author": "Megaview",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megaview/MegaviewUI.git"
  },
  "homepage": "https://github.com/megaview/MegaviewUI#readme",
  "bugs": {
    "url": "https://github.com/megaview/MegaviewUI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@open-wc/testing": "^4.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@storybook/addon-a11y": "^10.1.0",
    "@storybook/addon-docs": "^10.1.0",
    "@storybook/addon-vitest": "^10.1.0",
    "@storybook/web-components-vite": "^10.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-coverage-v8": "^0.8.0",
    "@web/test-runner-playwright": "^0.11.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "playwright": "^1.57.0",
    "semantic-release": "^24.2.9",
    "storybook": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "lit": "^3.3.1",
    "lucide": "^0.555.0",
    "marked": "^15.0.12",
    "tslib": "^2.8.1"
  }
}
