{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "stripInternal": true,
    "noEmit": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.stories.*",
    "**/*.test.*",
    "stories",
    "dist",
    "node_modules"
  ]
}

